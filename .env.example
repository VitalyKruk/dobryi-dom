# Хранение данных API в Postgres. Скопируйте в .env и заполните. Файл .env в git не попадает.

# Пароль базы для docker compose (сервис db). Придумайте длинный случайный.
POSTGRES_PASSWORD=

# Для тестов и запуска API вне Docker (npm run test:postgres): база из compose доступна на 127.0.0.1:5433.
# Без DATABASE_URL API вне Docker работает на JSON-файле data/db.json.
DATABASE_URL=postgres://dobryi:<пароль>@127.0.0.1:5433/dobryi_dom
