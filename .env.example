# Хранение данных API в Postgres. Скопируйте в .env и заполните. Файл .env в git не попадает.

# Пароль базы для docker compose (сервис db). Придумайте длинный случайный.
POSTGRES_PASSWORD=

# Для запуска API вне Docker: база из compose доступна на 127.0.0.1:5433.
# Без DATABASE_URL API вне Docker работает на JSON-файле data/db.json.
DATABASE_URL=postgres://dobryi:<пароль>@127.0.0.1:5433/dobryi_dom

# Отдельная база для npm run test:postgres — тесты стирают в ней данные. Имя обязано оканчиваться на _test,
# база создаётся сама при первом запуске тестов.
TEST_DATABASE_URL=postgres://dobryi:<пароль>@127.0.0.1:5433/dobryi_dom_test
