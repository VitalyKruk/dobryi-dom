{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dobryi-dom-docker-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); docker compose --profile dev up dev"
      ],
      "port": 5173
    },
    {
      "name": "dobryi-dom-docker-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); docker compose up --build web"
      ],
      "port": 8081
    },
    {
      "name": "dobryi-dom",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    }
  ]
}
